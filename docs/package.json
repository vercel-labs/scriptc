{
  "name": "@scriptc/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "next dev",
    "postinstall": "fumadocs-mdx",
    "build": "fumadocs-mdx && next build",
    "start": "next start",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "test:unit": "node --test test/compatibility-matrix.test.mjs",
    "test:routes": "node scripts/test-routes.mjs",
    "compat:check": "pnpm --dir .. node-compat:check",
    "check": "pnpm compat:check && pnpm typecheck && pnpm test:unit && pnpm build && pnpm test:routes"
  },
  "dependencies": {
    "@vercel/geistdocs": "2.7.8",
    "fumadocs-core": "16.2.2",
    "fumadocs-mdx": "14.0.4",
    "geist": "^1.7.0",
    "next": "16.3.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2",
    "@types/mdast": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "unist-util-visit": "^5.1.0"
  }
}
