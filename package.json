{
  "name": "scriptc-monorepo",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "build:fresh": "rm -rf packages/compiler/dist packages/cli/dist node_modules/.cache/scriptc-tsc && pnpm build",
    "build:native-compiler": "node --max-old-space-size=8192 --import tsx scripts/build-native-cli.mts",
    "bench:builds": "node scripts/bench-builds.mjs",
    "bench:runtime": "node scripts/bench-runtime.mjs",
    "bench:ast-access": "node scripts/bench-ast-access.mjs",
    "bench:backend-analysis": "node scripts/bench-backend-analysis.mjs",
    "test": "vitest run",
    "test:ts7": "node scripts/test-ts7.mjs",
    "test:checker-identity": "node scripts/checker-identity.mjs",
    "generate:ts7-ast": "node scripts/generate-ts7-ast-schema.mjs",
    "generate:ir-fields": "node scripts/generate-ir-fields.mjs",
    "test:fetch-conformance": "vitest run tests/harness/fetch-conformance.test.ts",
    "test:test262": "tsx tests/test262/run.ts",
    "test:test262:fetch": "node tests/test262/fetch.mjs",
    "test:cache-identity": "node tests/harness/cache-identity.mjs",
    "test:lowering-order": "node scripts/lowering-order.mjs --fail-on names",
    "test:sandbox": "node scripts/sandbox-test.mjs",
    "test:sandbox:image": "node scripts/sandbox-image.mjs",
    "test:watch": "vitest",
    "lint": "node docs/scripts/limitations-partials.mjs check && oxlint --deny-warnings packages scripts internal/compatibility/src tests/harness vitest.config.ts",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt --write \"{packages,scripts,internal/compatibility/src,tests/harness}/**/*.{js,mjs,cjs,ts,mts,cts,tsx}\" vitest.config.ts .oxlintrc.jsonc .oxfmtrc.jsonc",
    "format:check": "oxfmt --check \"{packages,scripts,internal/compatibility/src,tests/harness}/**/*.{js,mjs,cjs,ts,mts,cts,tsx}\" vitest.config.ts .oxlintrc.jsonc .oxfmtrc.jsonc",
    "manifest": "tsx scripts/surface-manifest.mjs",
    "node-compat": "pnpm --filter @internal/compatibility run update",
    "node-compat:backlog": "pnpm --filter @internal/compatibility run backlog --",
    "node-compat:check": "pnpm --filter @internal/compatibility run check",
    "scriptc": "tsx packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@scriptc/experimental": "workspace:*",
    "@scriptc/threads": "workspace:*",
    "@scriptc/types": "workspace:*",
    "@types/node": "^24.0.0",
    "effect": "3.22.2",
    "js-yaml": "4.3.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "rollup": "4.62.2",
    "smol-toml": "1.7.1",
    "three": "0.186.1",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "vercel": "58.1.0",
    "vitest": "^3.0.0"
  }
}
