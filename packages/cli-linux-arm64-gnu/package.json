{
  "name": "@scriptc/cli-linux-arm64-gnu",
  "version": "0.4.5",
  "description": "Native scriptc compiler for linux-arm64-gnu",
  "license": "Apache-2.0",
  "homepage": "https://scriptc.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel-labs/scriptc.git",
    "directory": "packages/cli-linux-arm64-gnu"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "arm64"
  ],
  "files": [
    "dist"
  ],
  "dependencies": {
    "@scriptc/llvm-linux-arm64-gnu": "workspace:*",
    "@scriptc/runtime-linux-arm64-gnu": "workspace:*"
  },
  "scripts": {
    "build": "node -e \"\"",
    "build:native": "node --max-old-space-size=8192 --import tsx ../../scripts/build-native-cli.mts dist --platform-packages",
    "prepack": "node ../../scripts/verify-native-cli.mjs ."
  },
  "publishConfig": {
    "access": "public"
  },
  "libc": [
    "glibc"
  ]
}
