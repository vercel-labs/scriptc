{
  "name": "@scriptc/llvm-darwin-x64",
  "version": "0.4.10",
  "description": "Pinned LLVM code-generation helper for scriptc on macOS x64",
  "license": "Apache-2.0 WITH LLVM-exception",
  "homepage": "https://scriptc.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel-labs/scriptc.git",
    "directory": "packages/llvm-darwin-x64"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "x64"
  ],
  "bin": {
    "scriptc-llvm-codegen": "bin/scriptc-llvm-codegen",
    "scriptc-comptime": "bin/scriptc-comptime"
  },
  "files": [
    "bin",
    "LICENSE",
    "SCRIPTC_LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "true",
    "build:native": "node scripts/build.mjs",
    "prepack": "test -x bin/scriptc-llvm-codegen && test -x bin/scriptc-comptime"
  },
  "publishConfig": {
    "access": "public"
  }
}
