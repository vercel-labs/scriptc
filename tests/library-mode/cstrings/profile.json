{
  "profile_format": 2,
  "name": "conformance-cstrings",
  "entry": "lib.ts",
  "emission": "llvm",
  "abi": {
    "prefix": "kc_",
    "init_symbol": "kc_init",
    "sink_register_symbol": "kc_set_panic_sink",
    "collect_symbol": "kc_collect",
    "result_reset_symbol": null,
    "callback_register_symbol": "kc_set_callback"
  },
  "callbacks": [{ "name": "log", "params": ["cstring", "f64"], "returns": "void" }],
  "exports": [
    { "export": "greet", "symbol": "kc_greet", "params": ["cstring"], "returns": "cstring" },
    { "export": "length", "symbol": "kc_length", "params": ["cstring"], "returns": "f64" },
    { "export": "echo", "symbol": "kc_echo", "params": ["cstring"], "returns": "f64" },
    { "export": "withNul", "symbol": "kc_with_nul", "params": [], "returns": "cstring" },
    { "export": "echoNul", "symbol": "kc_echo_nul", "params": [], "returns": "f64" }
  ]
}
