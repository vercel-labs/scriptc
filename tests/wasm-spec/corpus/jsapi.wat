;; tests/corpus/webassembly-jsapi.mjs: imports of every kind, filled by the
;; Memory, Table and Global constructors. The program's base64 copy also
;; carries custom sections ("dylink.0" [1 2 3], "meta" "hello", "dylink.0"
;; [4 5] and "" []), appended after wat2wasm.
(module
  (import "env" "log" (func $log (param i32)))
  (import "env" "memory" (memory 1 4))
  (import "env" "table" (table 2 8 funcref))
  (import "env" "counter" (global $counter (mut i32)))
  (import "env" "scale" (global $scale f64))
  (import "env" "big" (global $big (mut i64)))
  (import "env" "ref" (global $ref (mut externref)))
  (type $i_i (func (param i32) (result i32)))
  (func $double (type $i_i) (i32.mul (local.get 0) (i32.const 2)))
  (func $square (type $i_i) (i32.mul (local.get 0) (local.get 0)))
  (elem (i32.const 0) $double $square)
  (func (export "bump") (result i32)
    (global.set $counter (i32.add (global.get $counter) (i32.const 1)))
    (global.get $counter))
  (func (export "scaled") (param f64) (result f64) (f64.mul (local.get 0) (global.get $scale)))
  (func (export "bigAdd") (param i64) (global.set $big (i64.add (global.get $big) (local.get 0))))
  (func (export "getRef") (result externref) (global.get $ref))
  (func (export "setRef") (param externref) (global.set $ref (local.get 0)))
  (func (export "apply") (param i32 i32) (result i32)
    (call_indirect (type $i_i) (local.get 1) (local.get 0)))
  (func (export "store") (param i32 i32) (i32.store8 (local.get 0) (local.get 1)))
  (func (export "load") (param i32) (result i32) (i32.load8_u (local.get 0)))
  (func (export "size") (result i32) (memory.size))
  (func (export "grow") (param i32) (result i32) (memory.grow (local.get 0)))
  (func (export "tableSize") (result i32) (table.size 0))
  (func (export "say") (param i32) (call $log (local.get 0)))
  (export "memory" (memory 0))
  (export "table" (table 0))
  (export "counter" (global $counter))
  (export "alsoCounter" (global $counter))
  (export "double" (func $double))
)
